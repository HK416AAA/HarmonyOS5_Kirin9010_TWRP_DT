# ueventd.config - HarmonyOS device-node table for Kirin 9010.
#
# AUTHORITATIVE SOURCE. This is the OpenHarmony `ueventd.config` format (the
# `[device]` table written by HarmonyOS ueventd), taken from the stock
# OpenHarmony 5.0.5.165 updater ramdisk (`etc/ueventd.config`) plus the UFS
# by-name paths this device uses.
#
# TWRP's init is Android init/ueventd, which cannot read this file. The Android
# `ueventd.<hardware>.rc` it actually loads is GENERATED from this file by
# scripts/cfg2rc.py, so the two never drift. Do not edit the generated file.
#
# Format (OpenHarmony):
#   [device]
#   <device name> <mode> <uid> <gid>
#
# HarmonyOS group names are written as the numeric gids from the stock image's
# etc/group because Android ueventd does not know them:
#   root=0  system=1000  radio=1001  bluetooth=1002  graphics=1003
#   log=1007  media_rw=1023  dsoftbus=1024  audio=1041  shell=2000
#   camera_host=3028  composer_host=3036  update=6666  input=6696
#   watchdog=1100

[device]
# --- Core pseudo devices ---
/dev/null 0666 0 0
/dev/zero 0666 0 0
/dev/full 0666 0 0
/dev/ptmx 0666 0 0
/dev/tty 0666 0 0
/dev/random 0666 0 0
/dev/urandom 0666 0 0
/dev/ashmem 0666 0 0
/dev/binder 0666 0 0
/dev/hwbinder 0666 0 0
/dev/vndbinder 0666 0 0

# --- Input ---
/dev/input/event* 0660 0 6696
/dev/input/mice 0660 0 6696
/dev/input/mouse0 0660 0 6696
/dev/uinput 0660 3011 3011
/dev/uhid 0660 3011 3011
/dev/vinput 0660 1000 1004
/dev/hdf_input_event* 0660 3029 3029
/dev/hidraw* 0666 0 6696

# --- Display / graphics (Huawei TDE + DRM) ---
/dev/graphics/fb0 0660 1000 1003
/dev/hi_tde 0644 1000 1003
/dev/dri/card0 0666 0 1003
/dev/dri/card0-DSI-1 0666 0 1003
/dev/dri/card0-HDMI-A-1 0666 0 1003
/dev/dri/renderD128 0666 0 1003
/dev/hdmi 0660 1000 1005
/dev/hi_mipi 0660 1000 1005
/dev/hi_mipi_tx 0660 1000 1005

# --- Multimedia (VDP/VEN/ISP) ---
/dev/jpeg 0666 1000 1003
/dev/ion 0664 1000 1000
/dev/mmz_userdev 0644 1000 1005
/dev/vb 0666 1000 1005
/dev/vdec 0666 1000 1005
/dev/venc 0666 1000 1005
/dev/vi 0660 1000 1005
/dev/vo 0660 1000 1005
/dev/vpss 0660 1000 1005
/dev/gdc 0660 1000 1005
/dev/isp_dev 0660 1000 1006
/dev/video* 0660 3028 3028

# --- Security / tee / misc Huawei devices ---
/dev/tc_ns_client 0660 1000 1005
/dev/access_token_id 0666 3020 3020
/dev/auth_ctrl 0660 1000 1000
/dev/avs 0660 1000 1005
/dev/match 0660 1000 1005
/dev/photo 0660 1000 1005
/dev/rect 0660 1000 1005
/dev/rgn 0660 1000 1005
/dev/sys 0660 1000 1005
/dev/vgs 0666 1000 1005
/dev/rtc0 0640 3819 3819
/dev/watchdog 0660 1100 1100
/dev/HDF* 0666 0 0
/dev/i2c-* 0660 1000 1006
/dev/mem 0660 1000 1005

# --- Serial / debug (bring-up logs) ---
/dev/tty0 0660 0 1000
/dev/ttyS* 0666 0 0
/dev/ttyACM* 0666 0 0
/dev/ttyUSB* 0666 0 0
/dev/pmsg0 0222 0 1007

# --- Bluetooth ---
/dev/btusb0 0660 1002 1002
/dev/rtk_btusb 0660 1002 0
/dev/stpbt 0660 1002 1001
/dev/btdev* 0660 1024 1024

# --- Block devices ---
/dev/block/sd* 0660 0 1000
/dev/block/mmcblk* 0660 0 1000
/dev/block/vd* 0660 0 1000
/dev/block/nve* 0660 0 1000
/dev/block/zram* 0660 0 1000
/dev/block/hvgr* 0666 1000 1003
/dev/block/sdd19 0660 0 0

# The stock updater references /dev/block/by-name/*; the actual UFS host is
# fa500000.ufs. Cover both, plus a platform alias for other SoCs in the family.
/dev/block/platform/fa500000.ufs/by-name/* 0660 0 1000
/dev/block/platform/fa500000.ufs/* 0660 0 1000
/dev/block/platform/*/by-name/* 0660 0 1000
/dev/block/by-name/misc 0660 6666 6666
/dev/block/by-name/bootctrl 0660 6666 6666
