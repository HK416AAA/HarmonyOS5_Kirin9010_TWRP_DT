# init.recovery.harmony.rc
#
# HarmonyOS-specific recovery init hooks, derived from the official
# init.Kirin9010.cfg and fstab.Kirin9010.
#
# HarmonyOS conventions replicated here:
#   * PATH includes /usr/local/bin:/bin:/usr/bin:/system/bin:/vendor/bin
#   * the `system` partition mounts at /usr
#   * /system/bin is exposed as /bin
#   * extra product partitions: sys_prod, chip_prod, cust, version, preload, patch_hw
#   * /data/vendor/hyperhold is a symlink to /data/service/el1/0/hyperhold
#
# TWRP provides its own userspace, so no HarmonyOS services are started.

on early-init
    export PATH /usr/local/bin:/bin:/usr/bin:/system/bin:/vendor/bin
    mkdir /usr 0755 root root
    mkdir /sys_prod 0755 root root
    mkdir /chip_prod 0755 root root
    mkdir /version 0755 root root
    mkdir /preload 0755 root root
    mkdir /patch_hw 0755 root root

on init
    symlink /system/bin /bin
    mkdir /tmp 0777 system system
    mount tmpfs tmpfs /tmp mode=0755
    chown system system /tmp

on post-fs-data
    mkdir /data/lost+found 0770 root root
    mkdir /data/hisi_logs 0770 root system
    mkdir /data/service/el1/0/hyperhold 0600 root root
    symlink /data/service/el1/0/hyperhold /data/vendor/hyperhold
    mkdir /sdcard 0777 root root

on late-fs
    mount debugfs debugfs /sys/kernel/debug
