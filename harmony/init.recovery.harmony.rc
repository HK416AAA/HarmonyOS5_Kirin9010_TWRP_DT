# init.recovery.harmony.rc
#
# HarmonyOS-specific recovery init hooks, derived from the stock OpenHarmony
# 5.0.5.165 updater ramdisk (etc/init.updater.common.cfg, etc/init.usb.cfg,
# etc/fstab.updater) and the official device configs (init.Kirin9010.cfg,
# fstab.Kirin9010).
#
# HarmonyOS conventions replicated here:
#   * PATH includes /usr/local/bin:/bin:/usr/bin:/system/bin:/vendor/bin
#   * the `system` partition mounts at /usr
#   * /system/bin is exposed as /bin
#   * extra product partitions: sys_prod, chip_prod, cust, version, preload, patch_hw
#   * /data/vendor/hyperhold is a symlink to /data/service/el1/0/hyperhold
#   * the stock updater reads /dev/block/by-name/*, the device fstab uses
#     /dev/block/platform/fa500000.ufs/by-name/*
#
# TWRP provides its own userspace, so no HarmonyOS services are started.

on early-init
    export PATH /usr/local/bin:/bin:/usr/bin:/system/bin:/vendor/bin
    mkdir /usr 0755 root root
    mkdir /sys_prod 0755 root root
    mkdir /chip_prod 0755 root root
    mkdir /cust 0755 root root
    mkdir /version 0755 root root
    mkdir /preload 0755 root root
    mkdir /patch_hw 0755 root root

    # The stock updater and Huawei tooling use the short by-name path.
    symlink /dev/block/platform/fa500000.ufs/by-name /dev/block/by-name
    symlink /dev/block/platform/fa500000.ufs/by-name /dev/block/bootdevice

on init
    symlink /system/bin /bin
    mkdir /tmp 0777 system system
    mount tmpfs tmpfs /tmp mode=0755
    chown system system /tmp

    # HarmonyOS keeps firmware/vendor blobs mounted from the stock vendor
    # partition; make sure the legacy search paths exist.
    mkdir /vendor/firmware 0755 root root
    mkdir /etc/firmware 0755 root root

on post-fs-data
    mkdir /data/lost+found 0770 root root
    mkdir /data/hisi_logs 0770 root system
    mkdir /data/log 0770 root system
    mkdir /data/service/el1/0/hyperhold 0600 root root
    symlink /data/service/el1/0/hyperhold /data/vendor/hyperhold
    mkdir /sdcard 0777 root root

on late-fs
    mount debugfs debugfs /sys/kernel/debug

# The OHOS USB stack selects HDC through persist.sys.usb.config (shipped in
# etc/param/ohos.startup.para). Make sure the FunctionFS mountpoint that
# harmony/hdc/hdc-usb.sh uses is present.
on boot
    mkdir /dev/usb-ffs 0755 root root
    mkdir /dev/usb-ffs/hdc 0770 shell shell
