# GENERATED by scripts/cfg2rc.py - DO NOT EDIT.
# HarmonyOS sources: harmony/init.kirin9010.cfg, harmony/ohos.recovery.cfg

on early-init
    export PATH /usr/local/bin:/usr/bin:/bin:/system/bin:/vendor/bin:/sbin

on init
    mkdir /usr 0755 root root
    mkdir /sys_prod 0755 root root
    mkdir /chip_prod 0755 root root
    mkdir /cust 0755 root root
    mkdir /version 0755 root root
    mkdir /preload 0755 root root
    mkdir /patch_hw 0755 root root
    mkdir /log 0755 root root
    mkdir /misc 0755 root root
    mkdir /bootctrl 0755 system system
    mkdir /kernel 0755 root root
    mkdir /recovery_vendor 0755 root root
    mkdir /splash2 0755 root root
    mkdir /vendor/modem 0755 root root
    mkdir /vendor/firmware 0755 root root
    symlink /dev/block/platform/fa500000.ufs/by-name /dev/block/by-name
    symlink /dev/block/platform/fa500000.ufs/by-name /dev/block/bootdevice
    setprop sys.usb.configfs 1
    setprop sys.usb.controller efc00000.dwc3
    setprop const.product.model Kirin9010
    setprop const.product.manufacturer HUAWEI
    setprop const.product.brand HUAWEI
    setprop const.product.devicetype pad
    setprop const.product.hardwareversion Kirin9010
    setprop const.product.cpu.abilist arm64-v8a
    setprop const.recovery.mode 1

on post-fs-data
    mkdir /data/lost+found 0770 root root
    mkdir /data/hisi_logs 0770 root system
    mkdir /data/log 0770 root system
    mkdir /data/service/el1/0/hyperhold 0600 root root
    symlink /data/service/el1/0/hyperhold /data/vendor/hyperhold

on late-fs
    mount debugfs /sys/kernel/debug debugfs

on boot
    mkdir /dev/usb-ffs/hdc 0770 shell shell
