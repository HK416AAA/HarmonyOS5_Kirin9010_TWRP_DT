# init.recovery.kirin9010.rc - TWRP recovery init entry point.
#
# Loaded by TWRP's init via `import /init.recovery.${ro.hardware}.rc`, so this
# file is installed under both the `kirin` and `kirin9010` names because the
# property may carry either.
#
# This file is deliberately thin. All HarmonyOS bring-up (mount points,
# by-name symlinks, USB gadget selection, HarmonyOS file/path conventions) is
# stored as an OpenHarmony init config and translated to Android rc by
# scripts/cfg2rc.py before the build:
#
#   harmony/init.kirin9010.cfg   device bring-up
#   harmony/ohos.recovery.cfg    recovery-mode overlay
#        -> generated by scripts/cfg2rc.py
#   harmony/generated/init.recovery.harmony.rc
#
# Keeping the OHOS config authoritative and generating the rc from it means the
# two can never drift. Do not add HarmonyOS commands here; add them to the .cfg.

import /init.recovery.harmony.rc

# HarmonyOS HDC (Device Connector); no-op without the hdcd bundle.
import /init.recovery.hdc.rc
